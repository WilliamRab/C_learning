#include <graphics.h>
#include <conio.h>
#include <windows.h>

const int GRID = 40;
const int BOARD = 15; // 15x15 五子棋
int board[BOARD][BOARD]; // 0 空, 1 黑, 2 白

void drawBoard()
{
	setbkcolor(YELLOW);
	cleardevice();
	setlinecolor(BLACK);
	for (int i = 0; i <= BOARD; i++) {
		// 横线
		line(GRID, GRID + i * GRID, GRID + BOARD * GRID, GRID + i * GRID);
		// 竖线
		line(GRID + i * GRID, GRID, GRID + i * GRID, GRID + BOARD * GRID);
	}
}

void drawPiece(int r, int c, int player)
{
	int x = GRID * (c + 1);
	int y = GRID * (r + 1);
	int rads = GRID / 2 - 4;
	if (player == 1) {
		setfillcolor(BLACK);
		solidcircle(x, y, rads);
	}
	else if (player == 2) {
		setfillcolor(WHITE);
		solidcircle(x, y, rads);
		setlinecolor(BLACK);
		circle(x, y, rads);
	}
}

bool inBoard(int r, int c) { return r >= 0 && r < BOARD && c >= 0 && c < BOARD; }

bool checkWin(int r, int c, int player)
{
	const int dr[4] = {0, 1, 1, 1};
	const int dc[4] = {1, 0, 1, -1};
	for (int d = 0; d < 4; d++) {
		int cnt = 1;
		for (int k = 1; k <= 4; k++) {
			int nr = r + dr[d] * k;
			int nc = c + dc[d] * k;
			if (inBoard(nr, nc) && board[nr][nc] == player) cnt++; else break;
		}
		for (int k = 1; k <= 4; k++) {
			int nr = r - dr[d] * k;
			int nc = c - dc[d] * k;
			if (inBoard(nr, nc) && board[nr][nc] == player) cnt++; else break;
		}
		if (cnt >= 5) return true;
	}
	return false;
}

int main()
{
	initgraph(GRID * (BOARD + 1), GRID * (BOARD + 1));
	drawBoard();
	// 初始化棋盘
	for (int i = 0; i < BOARD; i++) for (int j = 0; j < BOARD; j++) board[i][j] = 0;

	int turn = 1; // 1 黑方先手
	bool finished = false;

	MOUSEMSG msg;
	settextstyle(20, 0, _T("微软雅黑"));
	outtextxy(10, 10, _T("按 R 重置，Esc 退出。本地双人，左键落子。"));

	while (true) {
		if (MouseHit()) {
			msg = GetMouseMsg();
			if (msg.uMsg == WM_LBUTTONDOWN && !finished) {
				int cx = msg.x;
				int cy = msg.y;
				// 计算最近的棋点
				double fx = (double)(cx - GRID) / GRID;
				double fy = (double)(cy - GRID) / GRID;
				int c = (int)(fx + 0.5);
				int r = (int)(fy + 0.5);
				if (inBoard(r, c) && board[r][c] == 0) {
					board[r][c] = turn;
					drawPiece(r, c, turn);
					if (checkWin(r, c, turn)) {
						finished = true;
						TCHAR buf[64];
						if (turn == 1) _stprintf_s(buf, _T("黑方获胜！按 R 重置。"));
						else _stprintf_s(buf, _T("白方获胜！按 R 重置。"));
						settextcolor(RED);
						outtextxy(GRID, GRID * (BOARD + 0.2), buf);
					}
					turn = 3 - turn; // 切换
				}
			}
		}

		if (_kbhit()) {
			int ch = _getch();
			if (ch == 27) break; // Esc 退出
			if (ch == 'r' || ch == 'R') {
				// 重置
				for (int i = 0; i < BOARD; i++) for (int j = 0; j < BOARD; j++) board[i][j] = 0;
				drawBoard();
				turn = 1;
				finished = false;
				settextcolor(BLACK);
				outtextxy(10, 10, _T("按 R 重置，Esc 退出。本地双人，左键落子。"));
			}
		}
		Sleep(10);
	}

	closegraph();
	return 0;
}
